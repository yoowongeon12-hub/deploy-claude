// Prisma ORM 스키마 파일
// 할일(Todo) 관리 애플리케이션을 위한 데이터베이스 스키마 정의
// 문서: https://pris.ly/d/prisma-schema

// Prisma Client 제너레이터 설정
generator client {
  provider = "prisma-client-js"
}

// 데이터베이스 연결 설정 (MySQL 사용)
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// 회원 정보 모델 (Member)
// ============================================================================
// 할일을 관리하는 회원(사용자) 정보를 저장합니다.
// 회원 1명이 여러 개의 할일을 가질 수 있는 일대다 관계를 정의합니다.
model Member {
  // 데이터베이스 테이블명을 tbl_member로 맵핑
  @@map("tbl_member")

  // 회원 고유 식별자 (자동 증가 정수)
  id Int @id @default(autoincrement())

  // 회원 이메일 (유니크 제약)
  memberEmail String @unique

  // 회원 비밀번호 (해시된 비밀번호 저장)
  memberPassword String

  // 회원 이름
  memberName String

  // 회원 나이
  memberAge Int

  // 회원 생성 일시 (자동으로 현재 시각 설정)
  memberCreateAt DateTime @default(now())

  // 할일 목록 (회원 1 : 할일 N 관계)
  todos Todo[]
}

// ============================================================================
// 할일 항목 모델 (Todo)
// ============================================================================
// 사용자가 관리할 할일 항목을 저장합니다.
// 각 할일은 하나의 회원에 속하며, 완료 여부를 추적할 수 있습니다.
model Todo {
  // 데이터베이스 테이블명을 tbl_todo로 맵핑
  @@map("tbl_todo")

  // 복합 인덱스: 회원별 할일을 최신순으로 조회하는 기본 쿼리 최적화
  // 회원 ID와 생성 일시(내림차순)로 정렬되어 조회 성능 향상
  @@index([memberId, createdAt(sort: Desc)])

  // 고유 식별자 (자동 증가 정수)
  id Int @id @default(autoincrement())

  // 회원 외래키 (필수)
  // 해당 할일이 어느 회원에 속하는지를 나타냄
  memberId Int

  // Member 모델과의 관계 정의
  // 회원이 삭제되면 해당 회원의 모든 할일도 자동 삭제됨 (Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  // ========================================================================
  // 기본 필드 (요구사항 필수 필드)
  // ========================================================================

  // 할일 제목 (필수, 최대 200자)
  // VARCHAR(200)로 정의하여 데이터베이스에서도 길이 제약 적용
  title String @db.VarChar(200)

  // 완료 여부 (기본값: false)
  // false = 미완료, true = 완료
  completed Boolean @default(false)

  // 생성 일시 (자동으로 현재 시각 설정, 변경 불가)
  createdAt DateTime @default(now())

  // 수정 일시 (생성 후 수정될 때마다 자동으로 갱신)
  updatedAt DateTime @updatedAt

  // ========================================================================
  // 추가 필드 (기능 확장용)
  // ========================================================================

  // 할일 완료 시간 (nullable, 아직 완료되지 않으면 null)
  // 완료된 시간을 기록하기 위해 사용
  completedAt DateTime?

  // 소프트 삭제 플래그 (기본값: false)
  // false = 정상, true = 삭제됨 (물리적 삭제 대신 논리적 삭제 사용)
  // 완전히 제거하지 않고 데이터를 보존하기 위해 사용
  isDeleted Boolean @default(false)
}

// ============================================================================
// 게시글 모델 (Post) - 비회원 게시판
// ============================================================================
// 비회원 사용자가 작성할 수 있는 게시글을 저장합니다.
// 게시글은 여러 개의 댓글을 가질 수 있으며, 조회수를 추적합니다.
model Post {
  // 데이터베이스 테이블명을 tbl_post로 맵핑
  @@map("tbl_post")

  // 복합 인덱스: 게시글 목록 조회 성능 최적화
  // 최신 게시글을 먼저 조회하고, 조회수가 높은 게시글도 빠르게 조회
  @@index([created_at(sort: Desc)])
  @@index([view_count(sort: Desc)])

  // 게시글 고유 식별자 (자동 증가 정수)
  id Int @id @default(autoincrement())

  // 게시글 제목 (필수, 최대 200자)
  // 게시글 목록 페이지에서 표시되는 메인 정보
  title String @db.VarChar(200)

  // 게시글 내용 (필수, 최대 10000자)
  // 게시글 상세보기 페이지에서 전체 내용 표시
  content String @db.VarChar(10000)

  // 작성자 이름 (필수, 비회원이므로 문자열)
  // 게시글 목록과 상세보기 페이지에서 표시
  author_name String

  // 조회수 (기본값: 0)
  // 게시글이 조회될 때마다 증가
  // 게시글 목록에서 표시되는 정보
  view_count Int @default(0)

  // 게시글 생성 일시 (자동으로 현재 시각 설정, 변경 불가)
  // 게시글 목록과 상세보기에서 표시
  created_at DateTime @default(now())

  // 게시글 수정 일시 (생성 후 수정될 때마다 자동으로 갱신)
  // 수정 여부 판단에 사용
  updated_at DateTime @updatedAt

  // 댓글 목록 (게시글 1 : 댓글 N 관계)
  // 게시글이 삭제되면 해당 게시글의 모든 댓글도 자동 삭제됨 (Cascade)
  comments Comment[]
}

// ============================================================================
// 댓글 모델 (Comment) - 비회원 게시판
// ============================================================================
// 게시글에 달린 댓글을 저장합니다.
// 각 댓글은 하나의 게시글에 속하며, 작성, 수정, 삭제가 가능합니다.
model Comment {
  // 데이터베이스 테이블명을 tbl_comment로 맵핑
  @@map("tbl_comment")

  // 복합 인덱스: 게시글별 댓글 조회 성능 최적화
  // 특정 게시글의 댓글을 시간순으로 빠르게 조회
  @@index([post_id, created_at(sort: Asc)])

  // 댓글 고유 식별자 (자동 증가 정수)
  id Int @id @default(autoincrement())

  // 게시글 외래키 (필수)
  // 해당 댓글이 어느 게시글에 달려 있는지를 나타냄
  post_id Int

  // Post 모델과의 관계 정의
  // 게시글이 삭제되면 해당 게시글의 모든 댓글도 자동 삭제됨 (Cascade)
  post Post @relation(fields: [post_id], references: [id], onDelete: Cascade)

  // 댓글 내용 (필수, 최대 2000자)
  // 게시글 상세보기 페이지에서 표시
  content String @db.VarChar(2000)

  // 작성자 이름 (필수, 비회원이므로 문자열)
  // 댓글 작성자를 구분하기 위해 사용
  author_name String

  // 댓글 생성 일시 (자동으로 현재 시각 설정, 변경 불가)
  // 댓글 목록에서 시간순 정렬에 사용
  created_at DateTime @default(now())

  // 댓글 수정 일시 (생성 후 수정될 때마다 자동으로 갱신)
  // 수정된 댓글임을 표시하는 데 사용
  updated_at DateTime @updatedAt
}
