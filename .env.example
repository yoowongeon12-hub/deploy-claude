# 애플리케이션 환경 설정
NODE_ENV=development

# 서버 포트
PORT=3000

# 데이터베이스 연결 URL
# PostgreSQL: postgresql://user:password@localhost:5432/database_name
# MySQL: mysql://user:password@localhost:3306/database_name
DATABASE_URL=postgresql://dev_user:dev_password@localhost:5432/todo_dev

# JWT 토큰 시크릿 (프로덕션에서는 강력한 값 사용)
JWT_SECRET=your_jwt_secret_key_here

# API 문서 설정
SWAGGER_ENABLED=true
SWAGGER_PATH=/api/docs

# CORS 설정
CORS_ORIGIN=http://localhost:3000

# 로깅 레벨 (debug, info, warn, error)
LOG_LEVEL=debug

# Redis 캐시 설정 (선택사항)
REDIS_URL=redis://localhost:6379

# 메이플 설정 (이메일)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# API 레이트 제한
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# 세션 설정
SESSION_SECRET=your_session_secret_key_here
SESSION_EXPIRY=86400

# 외부 서비스 API 키 (필요시 추가)
EXTERNAL_API_KEY=your_api_key_here
